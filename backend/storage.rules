rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasStorageSession() {
      return request.auth != null
        && request.auth.token.storageAccess == true;
    }

    function isGlobalStorageManager() {
      return hasStorageSession()
        && request.auth.token.role in [
          'owner',
          'gm',
          'super_admin',
          'management_accountant'
        ];
    }

    function canAccessBranch(branchId) {
      return hasStorageSession()
        && (isGlobalStorageManager() || request.auth.token.branchId == branchId);
    }

    match /transit-visas/{branchId}/{fileName} {
      allow read: if canAccessBranch(branchId);
      allow create, update: if canAccessBranch(branchId)
        && fileName.matches('^[a-f0-9]{64}\\.pdf$')
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if canAccessBranch(branchId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
